# 复制为 .env 并按需修改
APP_NAME=BudaiAgentMesh
DEBUG=false

# 元数据库: 本地默认 SQLite; 生产切 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://budai:budai@localhost:5432/budai_mesh
DATABASE_URL=
SQLITE_URL=sqlite+aiosqlite:///./data/budai_mesh.db

# 认证
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
# 内置账号: 用户名:密码:角色
BUILTIN_USERS=admin:admin123:admin,analyst:analyst123:analyst,viewer:viewer123:viewer

# 密钥加密
SECRET_KEY=change-me-secret-key

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# M6: 向量后端 (auto/brute_force/pgvector/milvus)
# auto: PostgreSQL 自动用 pgvector, 其余 (SQLite) 用全量余弦兜底
VECTOR_BACKEND=auto
# Milvus 连接地址 (仅 VECTOR_BACKEND=milvus 时生效), 例如 http://localhost:19530 或本地文件
# MILVUS_URI=http://localhost:19530

# M4: 事件总线 (可选, 不配置则用进程内总线; 配置后自动切 Kafka, 需 pip install aiokafka)
# KAFKA_BROKERS=localhost:9092

# M2: OpenAI 向量化 (可选, 不配置则用本地 HashEmbedder 兜底; 需 pip install openai)
# OPENAI_API_KEY=sk-...

# M6: 观测遥测 (OTLP/HTTP, 配置后启用; 兼容 Jaeger/Tempo 等收集器)
# OTEL_ENDPOINT=http://localhost:4318
OTEL_ENDPOINT=
OTEL_SERVICE_NAME=budai-agent-mesh

# M6: SSO / OAuth2.0 授权码登录 (配置后启用, 兼容任意标准 OIDC 提供方)
# 示例 (GitHub):
#   SSO_ENABLED=true
#   SSO_PROVIDER_NAME=GitHub
#   SSO_CLIENT_ID=xxx
#   SSO_CLIENT_SECRET=xxx
#   SSO_AUTHORIZE_URL=https://github.com/login/oauth/authorize
#   SSO_TOKEN_URL=https://github.com/login/oauth/access_token
#   SSO_USERINFO_URL=https://api.github.com/user
#   SSO_ROLE_CLAIM=role
#   SSO_DEFAULT_ROLE=viewer
#   SSO_REDIRECT_URI=http://localhost:5173/login
# 本地演示: 无需外部账号, 用内置演示 IdP (GET /mock-idp/authorize) 即可端到端跑通
SSO_ENABLED=false
SSO_PROVIDER_NAME=SSO
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_SCOPE=openid profile email
SSO_ROLE_CLAIM=role
SSO_DEFAULT_ROLE=viewer
SSO_REDIRECT_URI=http://localhost:5173/login
